{
  "name": "nyc-transit-map",
  "version": "0.2.0",
  "description": "Embeddable NYC subway and ferry map with host-injected transit data",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "docs/ARCHITECTURE.md",
    "docs/MAP-VIEW.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./styles.css": "./dist/styles.css",
    "./assets/*": "./dist/assets/*",
    "./leaflet": {
      "types": "./dist/leaflet.d.ts",
      "import": "./dist/leaflet.js"
    }
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts && node --experimental-strip-types scripts/check-geometry.mjs && node scripts/check-transit-style.mjs && node scripts/check-loading-cache.mjs && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "refresh:schedules": "python3 scripts/refresh-schedules.py",
    "format": "prettier --write src demo tests *.ts *.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.10.0",
    "pbf": "^5.1.2",
    "react": ">=18.2.0 <20"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    },
    "@mapbox/vector-tile": {
      "optional": true
    },
    "pbf": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.10.0",
    "pbf": "^5.1.2",
    "prettier": "^3.6.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
